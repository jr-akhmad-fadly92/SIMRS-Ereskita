// save Detail
$('#saveItemPem').on('click', function () {
	$.ajax({
		type: 'POST',
		url: '/pemakaian-simpan',
		data: $('#formAddPakai').serialize(),
		success: function (data) {
			if(data.sukses == false) {
				alert(data.message);
			}else if(data.sukses == true) {
				table.ajax.reload();
				$('input[name="masterobat_id"]').val("");
				$('input[name="jumlah"]').val(1);
				$('input[name="informasi1"]').val("");
				$('input[name="informasi2"]').val("");
			}
		}
	});
});
$('#saveItemEpo').on('click', function () {
	$(this).hide();
	$.ajax({
		type: 'POST',
		url: '/epo-simpan',
		data: $('#formAddEpo').serialize(),
		success: function (data) {
			if(data.sukses == false) {
				alert(data.message);
			}else if(data.sukses == true) {
				table2.ajax.reload();
				$('input[name="epo_masterobat_id"]').val("");
				$('input[name="epo_jumlah"]').val(1);
				$('input[name="epo_informasi1"]').val("");
				$('input[name="epo_informasi2"]').val("");
			}
			$('#saveItemEpo').show();
		}
	});
});
$('#saveItemResep').on('click', function () {
	$(this).hide();
	$.ajax({
		type: 'POST',
		url: '/resep-simpan',
		data: $('#formAddResep').serialize(),
		success: function (data) {
			if(data.sukses == false) {
				alert(data.message);
			}else if(data.sukses == true) {
				table3.ajax.reload();
				$('input[name="resep_masterobat_id"]').val("");
				$('input[name="resep_jumlah"]').val(1);
				$('input[name="resep_informasi1"]').val("");
				$('input[name="resep_informasi2"]').val("");
			}
			$('#saveItemResep').show();
		}
	});
});

// hapus Detail
$(document).on('click', '.hapus', function(e) {
	e.preventDefault();
	var id = $(this).attr('data-id');
	if (confirm('Apakah yakin item ini akan dihapus?')) {
		$.ajax({
			url: '/pemakaian-hapus/' + id,
			type: 'GET',
			success: function (data) {
				if(data.sukses == true) {
					table.ajax.reload();
				}else{
					alert("Item gagal dihapus");
				}
			}
		});
	}
})
$(document).on('click', '.hapus-det-epo', function(e) {
	e.preventDefault();
	var id = $(this).attr('data-id');
	if (confirm('Apakah yakin item ini akan dihapus?')) {
		$.ajax({
			url: '/epo-hapus/' + id,
			type: 'GET',
			success: function (data) {
				if(data.sukses == true) {
					table2.ajax.reload();
				}else{
					alert("Item gagal dihapus");
				}
			}
		});
	}
})
$(document).on('click', '.hapus-det-res', function(e) {
	e.preventDefault();
	var id = $(this).attr('data-id');
	if (confirm('Apakah yakin item ini akan dihapus?')) {
		$.ajax({
			url: '/resep-hapus/' + id,
			type: 'GET',
			success: function (data) {
				if(data.sukses == true) {
					table3.ajax.reload();
				}else{
					alert("Item gagal dihapus");
				}
			}
		});
	}
})

function editTindakan(folio_id) {
	$('#editTindakanModal').modal('show');
	$('.modal-title').text('Edit Tindakan');
	$('.select2').select2();
	$.ajax({
		url: '/rawat-inap/edit-tindakan/'+folio_id,
		type: 'GET',
		dataType: 'json',
		success: function (data) {
			console.log(data);
			$('input[name="folio_id"]').val(data.folio.id);
			$('input[name="registrasi_id"]').val(data.folio.registrasi_id);
			$('select[name="dpjp"]').val(data.dokter.dokter_id).trigger('change');
			$('select[name="pelaksana"]').val(data.folio.dokter_pelaksana).trigger('change');
			$('select[name="perawat"]').val(data.folio.perawat).trigger('change');
			$('select[name="tarif_id"]').val(data.folio.tarif_id).trigger('change');
		}
	});
}

function saveEditTindakan() {
	var data = $('#editTindakanForm').serialize();
	$.ajax({
		url: '/rawat-inap/save-edit-tindakan',
		type: 'POST',
		dataType: 'json',
		data: data,
		success: function (data) {
			if (data.sukses == true) {
				$('#editTindakanModal').modal('hide');
				location.reload();
			}
		}
	});
}

$(function () {
	$('#tindakanIrna').DataTable({
		'language'    : {
			"url": "/json/pasien.datatable-language.json",
		},
		'paging'      : false,
		'lengthChange': false,
		'searching'   : true,
		'ordering'    : true,
		'info'        : true,
		'autoWidth'   : false
	});
});

function updateStatus(val, id){
	$.ajax({
		headers: {
				'X-CSRF-TOKEN': $('meta[name="_token"]').attr('content')
		},
		url: '/penjualan/update-status-permintaan',
		type: 'POST',
		dataType: 'json',
		data: {value: val, id: id},
		success: function (data) {
			if (data.sukses) {
				if(val=='Sudah Diminum Pasien' || val=='Diserahkan'){
					table2.ajax.reload();
				}
			} else {
				alert('Gagal update status');
			}
		}
	});   
}

function ribuan(x) {
	return x.toString().replace(/\B(?=(\d{3})+(?!\d))/g, ".");
}

$('select[name="kategoritarif_id"]').on('change', function() {
	var tarif_id = $(this).val();
	var reg_id = {{ $reg_id }}
	if(tarif_id) {
		$.ajax({
			url: '/rawat-inap/getKategoriTarifID/'+tarif_id+'/'+reg_id,
			type: "GET",
			dataType: "json",
			success:function(data) {
				//$('select[name="tarif_id"]').append('<option value=""></option>');
				$('select[name="tarif_id"]').empty();
				$.each(data, function(key, value) {
					$('select[name="tarif_id"]').append('<option value="'+ value.id +'">'+ value.nama +' | '+ ribuan(value.total) +'</option>');
				});
			}
		});
	}else{
		$('select[name="tarif_id"]').empty();
	}
});
</script>
