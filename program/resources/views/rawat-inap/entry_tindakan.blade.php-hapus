<script type="text/javascript">
setTimeout(function(){ 
	var element = document.getElementById("tab_pakaiobat");
	element.classList.remove("active");
	var element2 = document.getElementById("tab_kpo");
	element2.classList.remove("active");
	var element3 = document.getElementById("tab_resepobat");
	element3.classList.remove("active");
}, 500);

// master Obat
$('.select2').select2();
$('select[name="masterobat_id"]').html('<option value=""></option>');
$.ajax({
	url: '/penjualan/master-obat/rawatinap',
	type: 'GET',
	dataType: 'json',
	success: function(data){
		$.each(data, function(index, val) {
			$('select[name="masterobat_id"]').append('<option value="'+val.id+'">'+val.nama+' | Rp '+ribuan(val.hargajual)+'</option>');
		});       
	}
});
$('select[name="epo_masterobat_id"]').html('<option value=""></option>');
$.ajax({
	url: '/penjualan/master-obat',
	type: 'GET',
	dataType: 'json',
	success: function(data){
		$.each(data, function(index, val) {
			$('select[name="epo_masterobat_id"]').append('<option value="'+val.id+'">'+val.nama+' | Rp '+ribuan(val.hargajual)+'</option>');
		});       
	}
});
$('select[name="resep_masterobat_id"]').html('<option value=""></option>');
$.ajax({
	url: '/penjualan/master-obat',
	type: 'GET',
