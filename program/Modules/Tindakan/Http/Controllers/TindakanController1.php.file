	public function hapusTindakan($id, $idreg, $pasien_id, $order=''){
    if(Auth::user()->hasRole(['operasi','rawatinap','rawatjalan','kasir','kamarbersalin','supervisor', 'rawatdarurat','administrator'])){
			$lunas = 'N';
			if(Auth::user()->hasRole(['supervisor'])){
				$lunas = 'Y';
			}
      if(Folio::where('id',$id)->where('lunas', $lunas)->delete()){
				Foliopelaksana::where('folio_id',$id)->delete();
				Foliopelaksana_tambah::where('folio_id',$id)->delete();
				Flashy::success('Tindakan berhasil dihapus');
			}else{
				Flashy::error('Tindakan gagal dihapus');
			}
    }
		if($order=='order'){
			return redirect('operasi/tindakan/'.$idreg);
		}else{
			return redirect('tindakan/entry/'.$idreg.'/'.$pasien_id);
		}
  }

	public function getTarif($kategoritarif_id='')
	{
    $tarif = Tarif::where('kategoritarif_id', '=', $kategoritarif_id)->where('jenis', session('jenis'))->where('total', '<>', 0)->select('nama', 'id', 'total')->get();
    return response()->json($tarif);
  }

	//VERIFIKASI TINDAKAN RJ/RD
	public function verifikasiRJ()
	{
    $data['registrasi'] = Registrasi::where('lunas', 'N')
                                    ->where('verif_rj', 'N')
                                    ->whereIn('status_reg', ['J1', 'J2', 'G1', 'G2'])
                                    ->where('created_at', 'like', date('Y-m-d').'%')->get();
    return view('kasir.verifikasiRJ.verifikasiRJ', $data)->with('no', 1);
  }

	public function detailVerifikasiRJ($registrasi_id)
	{
		$data['registrasi'] = Registrasi::select('id', 'pasien_id', 'status_reg', 'dokter_id', 'poli_id', 'bayar')->where('id', $registrasi_id)->first();
		$data['pasien'] = Pasien::find($data['registrasi']->pasien_id);
		$data['folio'] = Folio::where('registrasi_id', $registrasi_id)->where('verif_rj', 'N')->get();
		return view('kasir.verifikasiRJ.detailVerifikasiRJ', $data)->with(['no'=>1, 'baris'=>1]);
	}

	public function saveVerifikasiRJ(Request $request)
	{
		$jumlah = $request['jmlbaris'];
		$jml = [];
		for ($i=1; $i < $jumlah; $i++) {
		  if (!empty($request['verif_rj'.$i])) {
			$fol = Folio::where('id', $request['verif_rj'.$i])->first();
			$fol->verif_rj = 'Y';
			$fol->verif_rj_user = Auth::user()->name;
			$fol->update();

			$reg = Registrasi::find($fol->registrasi_id);
			$reg->verif_rj = 'Y';
			$reg->update();
			array_push($jml, $fol->id);
		  }
		}
		$data = Folio::whereIn('id', $jml)->get();
		$pesan = $data->count().' tindakan berhasil di verifikasi';
		Flashy::success($pesan);
		return response()->json(['sukses' => true]);
	}
	
	// ORDER
	public function laboratorium($layanan = '', $registrasi_id = '') {
		$data['reg']	 		= Registrasi::where('id', $registrasi_id)->first();
		$data['order'] 		= Orderlab::where('registrasi_id', $registrasi_id)->get();
		
		$data['layanan']	= '';
		$data['tipe']			= '';
		if($layanan=='irj'){
			$data['layanan']	= 'Jalan';
			$data['tipe']			= 'TA';
		}elseif($layanan=='darurat'){
			$data['layanan']	= 'Darurat';
			$data['tipe']			= 'TG';
		}elseif($layanan=='irna'){
			$data['layanan']	= 'Inap';
			$data['tipe']			= 'TI';
		}
		$data['depo']			= 'laboratorium';
    $data['jenis'] 		= Registrasi::where('id', '=', $registrasi_id)->first();
    $data['pasien'] 	= Pasien::find($data['jenis']->pasien_id);
		$data['dokter'] 	= Pegawai::where('kategori_pegawai', 1)->pluck('nama', 'id');
		$data['perawat'] 	= Pegawai::whereNotIn('kategori_pegawai', [1])->pluck('nama', 'id');
    $data['opt_poli'] = Poli::where('politype', 'L')->get();
		$data['folio']		= Folio::leftJoin('foliopelaksanas', 'folios.id', '=', 'foliopelaksanas.folio_id')
												->where('folios.registrasi_id', $registrasi_id)
												->where('folios.poli_tipe', 'L')
												->select('folios.*', 'foliopelaksanas.dokter_lab','foliopelaksanas.analis_lab')
												->get();
		return view('rawat-jalan.laboratorium', $data)->with('no', 1)->with('idreg', $registrasi_id);
	}
	public function simpan_laboratorium(Request $request) {
		request()->validate(['pemeriksaan' => 'required']);
		$lab = new Orderlab();
		$lab->registrasi_id = $request['registrasi_id'];
		$lab->pemeriksaan = $request['pemeriksaan'];
		$lab->user_id = Auth::user()->id;
		$lab->save();
		$reg = Registrasi::find($request['registrasi_id']);
		Flashy::success('Pendaftaran Laboratorium Sukses');		
		return redirect('/tindakan/entry/'.$reg->id.'/'.$reg->pasien_id);
		
		/* if($request['instalasi']=='Darurat'){
			return redirect('/tindakan/igd');
		}elseif($request['instalasi']=='Inap'){
			return redirect('/rawat-inap/billing');
		}else{
			return redirect('/tindakan');
		} */
	}
	
	public function radiologi($layanan = '', $registrasi_id = '') {
		$data['reg'] 		= Registrasi::where('id', $registrasi_id)->first();
		$data['order'] 	= Orderradiologi::where('registrasi_id', $registrasi_id)->get();
		$data['tindakanradiologi'] 	= TindakanRadiologi::join('mastermapping_biaya', 'mastermapping_biaya.tindakan_radiologi_id', '=', 'tindakan_radiologi.id')
											->select('mastermapping_biaya.id','mastermapping_biaya.kelompok','mastermapping_biaya.tindakan_radiologi_id')
											->get();
		
		$data['layanan']	= '';
		$data['tipe']			= '';
		if($layanan=='irj'){
			$data['layanan']	= 'Jalan';
			$data['tipe']			= 'TA';
		}elseif($layanan=='darurat'){
			$data['layanan']	= 'Darurat';
			$data['tipe']			= 'TG';
		}elseif($layanan=='irna'){
			$data['layanan']	= 'Inap';
			$data['tipe']			= 'TI';
		}
		$data['jenis'] 		= Registrasi::where('id', '=', $registrasi_id)->first();
		$data['pasien'] 	= Pasien::find($data['jenis']->pasien_id);
		$data['depo']			= 'radiologi';
		$data['dokter'] 	= Pegawai::where('kategori_pegawai', 1)->pluck('nama', 'id');
		$data['perawat'] 	= Pegawai::whereNotIn('kategori_pegawai', [1])->pluck('nama', 'id');
		$data['opt_poli'] = Poli::where('politype', 'R')->get();
		$data['detil_order']	= DataOrderRadiologi::where('registrasi_id',$registrasi_id)->get();
		$data['folio'] 		= Folio::join('foliopelaksanas', 'folios.id', '=', 'foliopelaksanas.folio_id')
											->where('registrasi_id', $registrasi_id)
											->whereNotIn('folios.jenis', ['PEM'])
											->select('folios.*', 'foliopelaksanas.dokter_radiologi','foliopelaksanas.radiografer')
											->where('poli_tipe', 'R')->get();
		return view('rawat-jalan.radiologi', $data)->with('no', 1)->with('idreg', $registrasi_id);
	}
	public function simpan_radiologi(Request $request) {
		request()->validate(['pemeriksaan' => 'required']);
		$lab = new Orderradiologi();
		$lab->registrasi_id = $request['registrasi_id'];
		$lab->pemeriksaan = $request['pemeriksaan'];
		$lab->user_id = Auth::user()->id;
		$lab->save();
		$reg = Registrasi::find($request['registrasi_id']);
		Flashy::success('Pendaftaran Radiologi Sukses');			
		return redirect('/tindakan/entry/'.$reg->id.'/'.$reg->pasien_id);	
		/* if($request['instalasi']=='Darurat'){
			return redirect('/tindakan/igd');
		}elseif($request['instalasi']=='Inap'){
			return redirect('/rawat-inap/billing');
		}else{
			return redirect('/tindakan');
		} */
	}
	
	public function penunjang($penunjang='', $layanan = '', $registrasi_id = '') {
		$data['reg'] 		= Registrasi::where('id', $registrasi_id)->first();
		$data['penunjang']= $penunjang;
		$poli_tipe = '';
		if($penunjang=='fis'){
			$data['order'] 	= Orderfisioterapi::where('registrasi_id', $registrasi_id)->get();
			$poli_tipe = 'F';
			$data['depo']			= 'fisioterapi';
			$data['header']		= 'Fisioterapi';
		}elseif($penunjang=='vk'){
			$data['order'] 	= Orderkamarbersalin::where('registrasi_id', $registrasi_id)->get();
			$poli_tipe = 'V';
			$data['depo']			= 'kamarbersalin';
			$data['header']		= 'Persalinan';
		}
		
		$data['layanan']	= '';
		$data['tipe']			= '';
		if($layanan=='irj'){
			$data['layanan']	= 'Jalan';
			$data['tipe']			= 'TA';
		}elseif($layanan=='darurat'){
			$data['layanan']	= 'Darurat';
			$data['tipe']			= 'TG';
		}elseif($layanan=='irna'){
			$data['layanan']	= 'Inap';
			$data['tipe']			= 'TI';
		}
		$data['jenis'] 		= Registrasi::where('id', '=', $registrasi_id)->first();
		$data['pasien'] 	= Pasien::find($data['jenis']->pasien_id);
		$data['dokter'] 	= Pegawai::where('kategori_pegawai', 1)->pluck('nama', 'id');
		$data['perawat'] 	= Pegawai::whereNotIn('kategori_pegawai', [1])->pluck('nama', 'id');
		$data['opt_poli'] = Poli::where('politype', $poli_tipe)->get();
		$data['folio'] 		= Folio::join('foliopelaksanas', 'folios.id', '=', 'foliopelaksanas.folio_id')
											->where('registrasi_id', $registrasi_id)
											->whereNotIn('folios.jenis', ['PEM'])
											->select('folios.*')
											->where('poli_tipe', $poli_tipe)->get();
		$kategori_tarif		= Kategoritarif::where('namatarif', $data['header'])->first();
		$data['kat_tarif']= 0;
		if($kategori_tarif!=null){
			$data['kat_tarif'] = $kategori_tarif->id;
		}
		return view('penunjang.penunjang', $data)->with('no', 1)->with('idreg', $registrasi_id);
	}
	public function simpan_penunjang(Request $request) {
		request()->validate(['pemeriksaan' => 'required']);
		if($request['penunjang']=='Fisioterapi'){
			$insert = new Orderfisioterapi();
		}elseif($request['penunjang']=='Persalinan'){
			$insert = new Orderkamarbersalin();
		}
		$insert->registrasi_id = $request['registrasi_id'];
		$insert->pemeriksaan = $request['pemeriksaan'];
		$insert->user_id = Auth::user()->id;
		$insert->save();
		$reg = Registrasi::find($request['registrasi_id']);
		Flashy::success('Pendaftaran sukses');
		return redirect('/tindakan/entry/'.$reg->id.'/'.$reg->pasien_id);	
		/* if($request['instalasi']=='Darurat'){
			return redirect('/tindakan/igd');
		}elseif($request['instalasi']=='Inap'){
			return redirect('/rawat-inap/billing');
		}else{
			return redirect('/tindakan');
		} */
	}

	//pemeriksaan object
	public function simpan_pemeriksaan_object(Request $request)
	{
		$cek = db::table('histori_pemeriksaan_object')->where('registrasi_id',$request['registrasi_id'])->where('kategori_pemeriksaan',$request['kategori_pemeriksaan'])->count();
		if($cek<1)
		{
			db::table('histori_pemeriksaan_object')->insert([
				'registrasi_id'=>$request['registrasi_id'],
				'pasien_id'=>$request['pasien_id'],
				'kategori_pemeriksaan'=>$request['kategori_pemeriksaan'],
				'keterangan'=>$request['keterangan'],
			]);
			return response()->json(['sukses'=>true]);
		}else{
			db::table('histori_pemeriksaan_object')->where('kategori_pemeriksaan',$request['kategori_pemeriksaan'])->update([
				'keterangan'=>$request['keterangan'],
			]);
			return response()->json(['sukses'=>false]);
		}
		
	}

	public function list_pemeriksaan_object($id)
	{
		$cek = db::table('histori_pemeriksaan_object')->where('registrasi_id',$id)->count();
		
		if($cek<1)
		{DB::statement(DB::raw('set @rownum=0'));
			$histori = db::table('registrasis')->where('id',$id)->get();
			return DataTables::of($histori)
			->addColumn('kategori_pemeriksaan', function ($data) {
				
				$btn = '';
				return $btn;
			})
			->addColumn('keterangan', function ($data) {
				
				$btn = '';
				return $btn;
			})
			->addColumn('aksi', function ($data) {
				
				$btn = '';
				return $btn;
			})
			->rawColumns(['aksi','kategori_pemeriksaan','keterangan'])
			->make(true);
		}else{
			DB::statement(DB::raw('set @rownum=0'));
			$histori = db::table('histori_pemeriksaan_object')->where('registrasi_id',$id)
			->select([
				DB::raw('@rownum  := @rownum  + 1 AS rownum'),
				'id','kategori_pemeriksaan','keterangan'
			]);
			return DataTables::of($histori)
			->addColumn('aksi', function ($data) {
				
				$btn = '<a class="btn btn-flat btn-danger btn-danger btn-sm hapus_pemeriksaan_object" data-id="'.$data->id.'">Hapus</a>';
				return $btn;
			})
			->rawColumns(['aksi'])
			->make(true);
			}
			
	}
	public function hapus_pemeriksaan_object($id)
	{   
		db::table('histori_pemeriksaan_object')->where('id',$id)->delete();
		return response()->json(['sukses' => true]);
	}
	
	public function cek_pembayaran(Request $request)
	{   
		$cek = Registrasi::where('id',$request['registrasi_id'])->first();
		if($cek->status_reg='J%')
		{
			$jenis='TA';
		}elseif($cek->status_reg='I%')
		{
			$jenis='TI';
		}else{
			$jenis='TG';
		}
		$cek_histori_object = db::table('histori_pemeriksaan_object')->where('registrasi_id',$request['registrasi_id'])->count();
		$cek_tindakan = db::table('folios')->where('registrasi_id',$request['registrasi_id'])->where('jenis',$jenis)->whereNotIn('namatarif',['Biaya Registrasi','Biaya Pendaftaran Rawat Inap'])->count();
		if($cek->berat_badan==null)
		{
			$note = 'mohon input terlebih dahulu berat badan';
			return response()->json(['sukses' => false,'note'=>$note]);	
		}elseif($cek->tekanan_darah==null)
		{
			$note = 'mohon input terlebih dahulu Tekanan Darah / Tensi';
			return response()->json(['sukses' => false,'note'=>$note]);	
		}elseif($cek->tinggi==null)
		{
			$note = 'mohon input terlebih dahulu Tinggi Badan';
			return response()->json(['sukses' => false,'note'=>$note]);	
		}elseif($cek->suhu==null)
		{
			$note = 'mohon input terlebih dahulu Suhu Badan';
			return response()->json(['sukses' => false,'note'=>$note]);	
		}elseif($cek->respirasi==null)
		{
			$note = 'mohon input terlebih dahulu Respirasi';
			return response()->json(['sukses' => false,'note'=>$note]);	
		}elseif($cek->tingkat_keluhan_pasien==null)
		{
			$note = 'mohon input terlebih dahulu Tingkat Keluhan';
			return response()->json(['sukses' => false,'note'=>$note]);	
		}elseif($cek->tingkat_keluhan_pasien==null)
		{
			$note = 'mohon input terlebih dahulu Tingkat Keluhan';
			return response()->json(['sukses' => false,'note'=>$note]);	
		}elseif($cek_histori_object<11)
		{
			$note = 'mohon input terlebih dahulu Pemeriksaan Object';
			return response()->json(['sukses' => false,'note'=>$note]);	
		}elseif($cek->diagnosa_awal==null and $cek->diagnosa_akhir==null)
		{
			$note = 'mohon input terlebih dahulu Tingkat Keluhan';
			return response()->json(['sukses' => false,'note'=>$note]);	
		}elseif($cek->diagnosa_awal==null and $cek->diagnosa_akhir==null)
		{
			$note = 'mohon input terlebih dahulu Tingkat Keluhan';
			return response()->json(['sukses' => false,'note'=>$note]);	
		}elseif($cek_tindakan<1)
		{
			$note = 'mohon input terlebih dahulu Tindakan';
			return response()->json(['sukses' => false,'note'=>$note]);	
		}else{
			$kondisi_pulang_pasien =  $request['kondisi_akhir_pasien'];
			$total_biaya = Folio::where('registrasi_id',$request['registrasi_id'])->sum('total');
			return response()->json(['sukses' => true,'kondisi_pasien'=>$kondisi_pulang_pasien,'total_biaya'=>'Rp. '.number_format($total_biaya)]);
		}
		
	}

	public function get_data_biaya($id)
	{
		DB::statement(DB::raw('set @rownum=0'));
		$folio = Folio::where('registrasi_id',$id)->whereIn('jenis',['TA','TI','TG'])
		->select([
			DB::raw('@rownum  := @rownum  + 1 AS rownum'),
			'namatarif','total','poli_id','id'
			])->get();
		return DataTables::of($folio)
		->addColumn('number_total', function ($data) {
            
            $btn = number_format($data->total);
            return $btn;
		})
		->addColumn('poli', function ($data) {
            
            $btn = baca_poli($data->poli_id);
            return $btn;
		})
		->addColumn('pelaksana', function ($data) {
			$cek_1 = db::table('foliopelaksanas')->where('folio_id',$data->id)->count();
			if($cek_1>0)
			{
				$data_1 = db::table('foliopelaksanas')->where('folio_id',$data->id)->first();
				$btn = baca_dokter($data_1->dokter_pelaksana);
            }else{
				$btn = ' ';
			}
            return $btn;
        })
		->make(true);
	}

	public function get_data_biaya_obat($id)
	{
		DB::statement(DB::raw('set @rownum=0'));
		$folio = Folio::where('registrasi_id',$id)->where('namatarif','like','FR%')->first();
		$obat = db::table('penjualandetails')->join('masterobats','masterobats.id','=','penjualandetails.masterobat_id')->whereNull('penjualandetails.alasan_hapus')->where('penjualandetails.no_resep',$folio->namatarif)
		->select(DB::raw('@rownum  := @rownum  + 1 AS rownum'),'masterobats.nama','penjualandetails.no_resep','penjualandetails.jumlah','penjualandetails.aturan_pakai','penjualandetails.hargajual')->get();
		return DataTables::of($obat)
		->addColumn('total', function ($data) {
            
            $btn = 'Rp. '.number_format($data->hargajual);
            return $btn;
		})
		->make(true);
	}
	public function get_total_biaya($id)
	{   
		$folio = Folio::where('registrasi_id',$id)->sum('total');
		return response()->json(['sukses' => true,'folio'=>'Rp. '.number_format($folio)]);
	}

	public function update_saran_dokter(Request $request)
	{   
		Registrasi::where('id',$request['registrasi_id'])->update([
			'saran'=>$request['saran'],
			'tanggal_kontrol'=>valid_date($request['tanggal_kontrol']),
		]);
		$reg = Registrasi::where('id',$request['registrasi_id'])->first();
		return response()->json(['sukses' => true]);
	}
}
