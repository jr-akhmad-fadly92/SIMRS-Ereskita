	public function namaTindakan(){
		$data['nama_tindakan_operasi'] = TindakanOperasi::all();
			$data['nama_tindakan_radiologi'] = TindakanRadiologi::all();
		return view('tindakan::nama_tindakan', $data)->with('no',1);
	}
	public function editNamaTindakan($id){
		$tindakan_nama = "";
		if(strtolower(Auth::user()->role()->first()->name)=='operasi'){
			$tindakan = TindakanOperasi::find($id);
			$tindakan_nama = $tindakan->tindakan_operasi;
		}elseif(strtolower(Auth::user()->role()->first()->name)=='radiologi'){
			$tindakan = TindakanRadiologi::find($id);
			$tindakan_nama = $tindakan->tindakan_radiologi;
		}
		return ['tindakan'=>$tindakan_nama];
	}
	public function hapusNamaTindakan($id){
		if(strtolower(Auth::user()->role()->first()->name)=='operasi'){
			$tindakan = TindakanOperasi::find($id);
		}elseif(strtolower(Auth::user()->role()->first()->name)=='radiologi'){
			$tindakan = TindakanRadiologi::find($id);
		}
		if($tindakan->delete()){
			Flashy::success('Nama tindakan berhasil dihapus');
		}else{
			Flashy::error('Nama tindakan gagal dihapus');
		}
		return redirect('/tindakan/data');
	}
	public function simpanNamaTindakan(Request $request){
		$id = "";
		if($request['id']!=""){
			$id = $request['id'];
		}
		if(strtolower(Auth::user()->role()->first()->name)=='operasi'){
			$tindakan = TindakanOperasi::find($id);
			if($tindakan==null){
				$tindakan = new TindakanOperasi;
			}
			$tindakan->tindakan_operasi = strtoupper($request['tindakan']);
		}elseif(strtolower(Auth::user()->role()->first()->name)=='radiologi'){
			$tindakan = TindakanRadiologi::find($id);
			if($tindakan==null){
				$tindakan = new TindakanRadiologi;
			}
			$tindakan->tindakan_radiologi = strtoupper($request['tindakan']);
		}
		if($tindakan->save()){
			return ['status'=>true];
		}else{
			return ['status'=>false];
		}
	}
	
	public function index()
	{
		if(strtolower(Auth::user()->role()->first()->name)=='rawatdarurat'){
			return redirect('/tindakan/igd');
		}
		session()->forget(['dokter', 'pelaksana', 'perawat']);
		$data['poli'] 			= Poli::select('nama', 'id')->where('politype', 'J')->get();
		
		if(session('poli_id')==0){
			$data['registrasi'] = null;
		}else{
			// ->whereIn('posisi_pasien',['menunggu antrian','sedang diperiksa','rawat inap'])
			$data['registrasi'] = Registrasi::where('poli_id',session('poli_id'))->where('status_reg', 'like', 'J%')->where('pulang',null)->get();
		}
		return view('tindakan::index', $data)->with('no', 1);
	}

	public function index_dokter()
	{
		if(strtolower(Auth::user()->role()->first()->name)=='rawatdarurat'){
			return redirect('/tindakan/igd');
		}
		session()->forget(['dokter', 'pelaksana', 'perawat']);
		$poli_dokter 			= db::table('pegawais')->where('id',Auth::user()->pegawai_id)->first();
		$data['poli'] 			= Poli::select('nama', 'id')->where('politype', 'J')->where('id',$poli_dokter->poli_id)->get();
		
		if(session('poli_id')==0){
			$data['registrasi'] = Registrasi::where('poli_id',$poli_dokter->poli_id)->where('status_reg', 'like', 'J%')->where('pulang',null)->get();
		}else{
			// ->whereIn('posisi_pasien',['menunggu antrian','sedang diperiksa','rawat inap'])
			$data['registrasi'] = Registrasi::where('poli_id',session('poli_id'))->where('status_reg', 'like', 'J%')->where('pulang',null)->get();
		}
		return view('tindakan::index_dokter', $data)->with('no', 1);
	}

	public function index_byTanggal(Request $request)
	{
		if(strtolower(Auth::user()->role()->first()->name)=='rawatdarurat'){
			return redirect('/tindakan/igd');
		}
		elseif(strtolower(Auth::user()->role()->first()->name)=='rawatjalan'){
		session()->forget(['dokter', 'pelaksana', 'perawat']);
		session(['poli_id' => $request['poli_id']]);
		session(['ruang' => $request['ruang']]);
		
		$data['poli'] 			= Poli::select('nama', 'id')->where('politype', 'J')->get();
		// ->whereIn('posisi_pasien',['menunggu antrian','sedang diperiksa','rawat inap'])
		$data['registrasi'] = Registrasi::where('poli_id',$request['poli_id'])->where('status_reg', 'like', 'J%')->where('pulang',null)->get();
		
		return view('tindakan::index', $data)->with('no', 1);
		}elseif(strtolower(Auth::user()->role()->first()->name)=='dokter'){
			session()->forget(['dokter', 'pelaksana', 'perawat']);
			session(['poli_id' => $request['poli_id']]);
			session(['ruang' => $request['ruang']]);
			
			$data['poli'] 			= Poli::select('nama', 'id')->where('politype', 'J')->get();
			// ->whereIn('posisi_pasien',['menunggu antrian','sedang diperiksa','rawat inap'])
			$data['registrasi'] = Registrasi::where('poli_id',$request['poli_id'])->where('status_reg', 'like', 'J%')->where('pulang',null)->get();
			
			return view('tindakan::index_dokter', $data)->with('no', 1);
		}else{
		session()->forget(['dokter', 'pelaksana', 'perawat']);
		session(['poli_id' => $request['poli_id']]);
		session(['ruang' => $request['ruang']]);
		
		$data['poli'] 			= Poli::select('nama', 'id')->where('politype', 'J')->get();
		// ->whereIn('posisi_pasien',['menunggu antrian','sedang diperiksa','rawat inap'])
		$data['registrasi'] = Registrasi::where('poli_id',$request['poli_id'])->where('status_reg', 'like', 'J%')->where('pulang',null)->get();
		
		return view('tindakan::index', $data)->with('no', 1);
		}
		
	}

	public function tindakanIGD()
	{
		if(strtolower(Auth::user()->role()->first()->name)=='rawatjalan'||strtolower(Auth::user()->role()->first()->name)=='administrator'){
			return redirect('/tindakan');
		}elseif(strtolower(Auth::user()->role()->first()->name)=='rawatdarurat'||strtolower(Auth::user()->role()->first()->name)=='administrator'){
			session()->forget(['dokter', 'pelaksana', 'perawat']);
			// ->whereIn('posisi_pasien',['menunggu antrian','sedang diperiksa','rawat inap'])
			$data['registrasi'] = Registrasi::where('status_reg', 'like', 'G%')->where('pulang',null)->get();
			return view('tindakan::indexIGD', $data)->with('no', 1);
		}else{
			return redirect('/dashboard');
		}
		
	}

	public function tindakanIGD_byTanggal(Request $request)
	{
		if(strtolower(Auth::user()->role()->first()->name)=='rawatjalan'){
			return redirect('/tindakan');
		}
		request()->validate(['tga'=>'required']);
		session()->forget(['dokter', 'pelaksana', 'perawat']);
		// ->whereIn('posisi_pasien',['menunggu antrian','sedang diperiksa','rawat inap'])
		$data['registrasi'] = Registrasi::where('status_reg', 'like', 'G%')->where('pulang',null)->whereBetween('created_at', [valid_date($request['tga']).' 00:00:00', valid_date($request['tgb']).' 23:59:59'])->get();
		return view('tindakan::indexIGD', $data)->with('no', 1);
	}

	public function ajax_tindakanIGD()
	{
		$data['registrasi'] = Registrasi::where('status_reg', 'like', 'G%')->where('pulang',null)->where('created_at', '>=', Carbon::now()->format('Y-m-d'))->get();
		return view('tindakan::view_ajax', $data)->with('no', 1);
	}

